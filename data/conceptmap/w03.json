th": 0.7, "basis": "", "section": "w03-s04"}, {"source": "무엇", "target": "탁월함", "relation_type": "conditional", "direction": "unidirectional", "strength": 0.7, "basis": "", "section": "w03-s04"}, {"source": "무엇", "target": "탁월함", "relation_type": "conditional", "direction": "unidirectional", "strength": 0.7, "basis": "", "section": "w03-s04"}], "extra_nodes": [{"id": "미선성", "definition": "다듬어진 육체와 윤리적 고귀성의 합일"}, {"id": "형식적 교육", "definition": ""}, {"id": "인간 척도설", "definition": "만물의 척도는 인간이다. 있는 것들에 대해서는 있다는 것의, 없는 것들에 대해서는 없다는 것의 척도이다."}, {"id": "엔키클리오스 파이데이아", "definition": ""}, {"id": "유료화", "definition": ""}, {"id": "구교육", "definition": ""}, {"id": "신교육", "definition": ""}, {"id": "국가 주도 군사적 교육", "definition": ""}, {"id": "자발적 활동으로서의 교육", "definition": "국가가 통제하지 않는 자발적 활동"}, {"id": "품행", "definition": ""}, {"id": "무지의 지", "definition": "그들은 모르면서 안다고 여김, 나는 모른다고 여김"}, {"id": "변증술", "definition": "무지를 자처하며 상대의 의견을 검토·논박"}, {"id": "논박술", "definition": "처음 주장과 모순되는 주장을 하게 만듦"}, {"id": "대화술", "definition": "끊임없는 질문의 제시"}, {"id": "소명", "definition": "소크라테스 — 가르침을 소명(Charisma)으로 인식"}, {"id": "분별력", "definition": ""}, {"id": "영혼에 대한 염려", "definition": ""}, {"id": "덕에 의한 재화의 선함", "definition": "돈으로부터 덕이 생기는 것이 아니라, 덕에 의하여 돈이나 그 밖의 모든 것이 인간을 위하여 좋은 것이 됩니다."}, {"id": "덕의 교육 가능성", "definition": "덕은 가르칠 수 있고, 또 가르쳐야 함"}, {"id": "델포이 신탁", "definition": ""}, {"id": "덕", "definition": "용기를 포함한 분별·정의·경건·지혜로 구성된 전체"}, {"id": "덕은 지식이다", "definition": "용기 있는 자가 선하면 현명하다는 데서 도출되는, 덕이 곧 지식이라는 명제"}, {"id": "반례", "definition": "사례형 정의에 대한 소크라테스식 반박 수단으로, 하나의 사실로 제시된 답을 무너뜨리는 사례"}, {"id": "사례형 정의", "definition": "용기를 구체적 행위 사례(대열을 지켜 싸움 등)로 제시하는 정의 방식"}, {"id": "만용", "definition": "분별 없이 가지는 대담함으로 어린이와 짐승도 가질 수 있는 것, 참된 용기와 구별됨"}, {"id": "두려워할 것과 대담하게 할 것에 대한 앎", "definition": "니키아스가 제시한 용기의 정의로, 두려움을 주는 것과 주지 않는 것에 대한 지식"}, {"id": "검토", "definition": "소크라테스가 상대의 주장을 캐묻고 반례로 무너뜨리는 대화적 방법"}, {"id": "앎의 무시간성", "definition": "참된 지식은 과거·현재·미래의 구분 없이 동일한 대상에 대해 동일하게 성립한다는 논점"}, {"id": "다섯 근본덕", "definition": "플라톤 윤리학에서 정리되는 다섯 가지 근본적인 덕의 목록"}, {"id": "앎", "definition": "일단 묶이고 나면 그것들은 앎이 되고, 그제야 자리를 지킨다네."}, {"id": "덕의 부분", "definition": ""}, {"id": "메논의 역설", "definition": "사람은 자기가 아는 것도 알지 못하는 것도 탐구할 수 없네. 아는 것은 이미 아니 탐구할 필요가 없고, 알지 못하는 것은 무엇을 찾아야 할지 모르니 탐구할 수 없기 때문일세."}, {"id": "상기", "definition": "자연 전체가 한 혈통이고 영혼은 모든 것을 이미 배웠으므로, 단 하나를 상기한 사람이 — 사람들은 이것을 '배움'이라 부르지 — 나머지 모든 것을 스스로 발견하지 못할 이유가 없네."}, {"id": "참인 확신", "definition": "참인 확신은 제자리에 머물러 있는 동안에는 훌륭한 것이고 온갖 좋은 일을 해내네. 그러나 오래 머물지 않고 사람의 마음에서 달아나 버리지."}, {"id": "가르쳐질 수 있음", "definition": ""}, {"id": "가설적 방법", "definition": "우리는 그것이 무엇인지도 그것이 어떤 것인지도 알지 못 하기 때문에, 가설을 세우고 나서 우리 함께 이것을, 즉 그것이 가르쳐질 수 있는 것인지 가르쳐질 수 없는 것인지를 살펴보도록 하세."}, {"id": "탐구", "definition": ""}, {"id": "배움", "definition": ""}, {"id": "결박", "definition": "인식을 올바른 확신과 구별시키는 작용"}, {"id": "신적인 섭리", "definition": "탁월함이 사람에게 생기게 하는 원인으로 제시되는 것"}, {"id": "가르침 가능성", "definition": "탁월함이 가르쳐질 수 있는 것인지에 관한 물음의 대상"}], "analysed_sections": ["w03-s01", "w03-s02", "w03-s03", "w03-s04"], "sections_total": 4}